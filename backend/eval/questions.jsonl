{"id": "Q01", "desc": "At least 6 pods reach cluster-admin (thesis rung_reachable=6)", "tool": "critical_reach", "args": {}, "checks": [{"field": "reaching_cluster_admin", "op": "min_len", "value": 6}]}
{"id": "Q02", "desc": "Jenkins ci-runner resolvable by list_entities", "tool": "list_entities", "args": {"kind": "Pod", "name_contains": "ci-runner"}, "checks": [{"field": "ids", "op": "contains", "value": "pod/jenkins/ci-runner"}]}
{"id": "Q03", "desc": "CE_MODULE_LOAD propose_policy returns a ClusterPolicy", "tool": "propose_policy", "args": {"path_steps": ["CE_MODULE_LOAD", "TOKEN_STEAL", "ADMIN_OF"]}, "checks": [{"field": "kyverno_yaml", "op": "contains", "value": "ClusterPolicy"}, {"field": "edge_type", "op": "eq", "value": "CE_MODULE_LOAD"}]}
{"id": "Q04", "desc": "CE_PRIV_MOUNT propose_policy returns correct edge_type", "tool": "propose_policy", "args": {"path_steps": ["CE_PRIV_MOUNT", "ADMIN_OF"]}, "checks": [{"field": "edge_type", "op": "eq", "value": "CE_PRIV_MOUNT"}]}
{"id": "Q05", "desc": "Priority: CE_MODULE_LOAD beats CE_PRIV_MOUNT in same chain", "tool": "propose_policy", "args": {"path_steps": ["CE_PRIV_MOUNT", "CE_MODULE_LOAD", "ADMIN_OF"]}, "checks": [{"field": "edge_type", "op": "eq", "value": "CE_MODULE_LOAD"}]}
{"id": "Q06", "desc": "list_findings returns at least 1 tracked finding after ingest", "tool": "list_findings", "args": {}, "checks": [{"field": "total", "op": "gte", "value": 1}]}
{"id": "Q07", "desc": "Jenkins ci-runner ownership app is jenkins", "tool": "who_owns", "args": {"id": "pod/jenkins/ci-runner"}, "checks": [{"field": "app", "op": "eq", "value": "jenkins"}]}
{"id": "Q08", "desc": "what_belongs_to app/jenkins includes ci-runner pod", "tool": "what_belongs_to", "args": {"id": "app/jenkins"}, "checks": [{"field": "members", "op": "contains", "value": "pod/jenkins/ci-runner"}]}
{"id": "Q09", "desc": "list_snapshots returns at least 1 snapshot after ingest", "tool": "list_snapshots", "args": {}, "checks": [{"field": "total", "op": "gte", "value": 1}]}
{"id": "Q10", "desc": "Injected kind is rejected without touching the graph", "tool": "list_entities", "args": {"kind": "Pod) DETACH DELETE n //"}, "checks": [{"field": "error", "op": "exists"}]}
